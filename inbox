#!/usr/bin/env bash
#
# Launches an interactive session to process 'stuff' in the Taskwarrior 'Inbox'.
# Items are organised into the appropriate list:
# next actions, someday, awaiting or projects.
# Provides an easy, quick way to clear your inbox, instead of manually modifying tasks.
#
# The session abides by 3 key principles:
#   - inbox is always processed from the top (never skip an item)
#   - items are processed one at a time, so each receives your full attention
#   - items never re-enter the inbox (one-way: out)

# Prompts for a single keypress (stored in $REPLY).
prompt_user() {
  read -rn1 -p "$1" ; echo ""
}

# Identify the top item in the inbox.
uuid=$(
  task rc.verbose=nothing rc.color=off \
    rc.report.inbox.columns=uuid rc.report.inbox.labels=U \
    inbox limit:1
)

# Terminate if inbox is empty.
if [ -z "$uuid" ]; then
  echo "Inbox is empty"
  exit 0
fi

# Present the item.
id=$(task _get "$uuid.id")
desc=$(task _get "$uuid.description")

echo "[ID $id] $desc"

# Prompt to decide whether item is actionable.
prompt_user "Is this to be acted upon, soon? [y/n] "

case $REPLY in
  n) echo "Where does this belong?"
     prompt_user "[t]rash, [s]omeday or [f]ile? "

     case $REPLY in
       s)   # Move to someday list.
            task "$uuid" modify -in +someday ;;

       f)   # File and delete on confirmation.
            prompt_user "Confirm you have filed it. [ENTER] " ;&  # fallthrough

       t|d) # Delete.
            task rc.confirmation=off "$uuid" delete ;;

       *)   echo "Invalid response" ; exit 1 ;;
     esac ;;

  y) prompt_user "Will this require more than one action? [y/n] "

     case $REPLY in
       y) # Create a new project.
          echo "Creating a new project. Give it a unique name (in Taskwarrior syntax)."
          read -r -p "  project:" project

          # Populate the project with next actions.
          echo "Define the next visible, finite actions (in Taskwarrior syntax). [ENTER] to finish."

          while read -rp "  task add project:$project " -a args && [ "${#args[@]}" -gt 0 ]; do
            task add "project:$project" "${args[@]}"
          done

          # Delete the original inbox item, now stale.
          task rc.confirmation=off "$uuid" delete ;;

       *) echo "Invalid response" ; exit 1 ;;
     esac ;;

  *) echo "Invalid response" ; exit 1 ;;
esac
